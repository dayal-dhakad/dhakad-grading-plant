{
  "name": "@dhakad/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && wait-on http://localhost:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo No desktop tests required in Phase 1",
    "package": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "in.dhakad.gradingplant",
    "productName": "Dhakad Grading Plant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/offline.html",
        "to": "offline.html"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Dhakad-Grading-Plant-Setup-${version}.${ext}"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dhakad Grading Plant",
      "uninstallDisplayName": "Dhakad Grading Plant"
    }
  },
  "description": "Windows desktop shell for Dhakad Grading Plant",
  "author": "Dhakad Grading Plant"
}
